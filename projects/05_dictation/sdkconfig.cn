# Chinese build. Pair with sdkconfig.defaults.
# Mandarin is the language that fits: ~400 base syllables against MultiNet's
# 300-command ceiling, where English syllable inventory runs to thousands.
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_DICT_LANG_CN=y
CONFIG_DICT_PROBE_SYLLABLES=n
CONFIG_DICT_SYLLABLE_LIMIT=20
